---
import { content } from '../data/content.mjs';
import { appUrl, type Locale } from '../lib/site';
import MenuField from './MenuField.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const p = content[locale].download.pwa;
const osIcons = { windows: 'windows', macos: 'mac', linux: 'linux', chromeos: 'globe', android: 'android', ios: 'ipad', other: 'globe' } as const;
const systems = Object.keys(p.systems) as (keyof typeof osIcons)[];
---
<section class="pwa" aria-labelledby="pwa-title">
  <h2 id="pwa-title">{p.title}</h2>
  <p>{p.intro}</p>
  <div class="pwa-browser" hidden>
    <MenuField id="pwa-os" label={p.os} value="other" options={systems.map(value => ({ value, label: p.systems[value], icon: osIcons[value] }))} />
    <MenuField id="pwa-browser" label={p.browser} value="other" options={Object.entries(p.browsers).map(([value, label]) => ({ value, label }))} />
  </div>
  <div id="pwa-instructions" aria-live="polite">
    {Object.entries(p.fallback).map(([id, text]) => <p data-pwa-fallback={id} hidden>{text}</p>)}
    {Object.entries(p.guides).map(([id, guide]) => (
      <div data-pwa-guide={id} hidden={id !== 'generic'}>
        <ol><li><a href={appUrl} target="_blank" rel="noopener noreferrer">{p.open}</a></li><li>{guide.step}</li></ol>
        {'note' in guide && guide.note && <p class="pwa-note">{guide.note}</p>}
      </div>
    ))}
  </div>
</section>

<script>
  import '../scripts/pwa.js';
</script>
