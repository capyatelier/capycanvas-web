---
import { content } from '../data/content.mjs';
import { releasesUrl } from '../lib/releases.mjs';
import { releases } from '../lib/release-data';
import { platforms, type Locale } from '../lib/site';
import { formatDate, formatSize } from '../lib/format';
import Icon from './Icon.astro';
import Phrase from './Phrase.astro';
import ReleaseNotes from './ReleaseNotes.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { lang, download } = content[locale];
const t = content[locale].versions;
---
<main id="main" class="page">
  <h1>{t.title}</h1>
  <p class="lead">{releases.length ? t.intro : t.empty}</p>
  {releases.length > 0 && locale !== 'en' && <p class="notes-language">{download.notesLanguage}</p>}
  {releases.map((release, index) => (
    <article class="release" id={`v${release.version}`} aria-labelledby={`v${release.version}-title`}>
      <h2 id={`v${release.version}-title`}><Phrase text={t.version}><span slot="version">{release.version}</span></Phrase></h2>
      <p class="release-date">
        <span><Phrase text={t.released}><time slot="date" datetime={release.date}>{formatDate(lang, release.date)}</time></Phrase></span>
        {index === 0 && <span class="release-latest">{t.latest}</span>}
      </p>
      <ul class="release-files" aria-label={t.files}>
        {platforms.map((platform, i) => {
          const file = platform === 'ipad' ? undefined : release.files[platform];
          return file && <li><a href={file.url}><Icon name={platform} />{download.platforms[i]}</a><span>{formatSize(lang, file.size)}</span></li>;
        })}
        {release.checksums && <li><a href={release.checksums.url}><Icon name="circleCheck" />{release.checksums.name}</a></li>}
      </ul>
      {release.notes && <ReleaseNotes html={release.notes} />}
    </article>
  ))}
  <p class="all-releases"><a href={releasesUrl}>{download.allReleases}<Icon name="external" /></a></p>
</main>

<style>
  .notes-language { margin-top: -16px; font-size: 13px; color: var(--muted); }
  .release { max-width: 640px; margin-top: 40px; }
  .release h2 { font-size: 20px; font-weight: 650; line-height: 1.35; margin-bottom: 2px; }
  .release-date { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin-bottom: 14px; font-size: 13px; color: var(--muted); }
  .release-latest { padding: 0 8px; border-radius: 999px; background: var(--selected); color: var(--ink); font-size: 11px; font-weight: 600; line-height: 20px; }
  .release-files { display: flex; flex-wrap: wrap; gap: 6px 8px; list-style: none; margin: 0 0 18px; padding: 0; }
  .release-files li { display: flex; align-items: center; border-radius: 6px; background: var(--surface); font-size: 13px; }
  .release-files a { display: inline-flex; align-items: center; gap: 7px; min-height: 36px; padding: 6px 4px 6px 12px; font-weight: 600; }
  .release-files li:has(> :only-child) a { padding-right: 12px; }
  .release-files a:hover { color: var(--accent); }
  .release-files span { padding: 0 12px 0 6px; color: var(--muted); }
  .release-files :global(svg) { width: 16px; height: 16px; }
  .all-releases { margin: 40px 0 0; font-size: 13px; }
  .all-releases a { display: inline-flex; align-items: center; gap: 4px; color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .all-releases :global(svg) { width: 12px; height: 12px; }
</style>
