---
import { content } from '../data/content.mjs';
import { docsUI } from '../data/docs-ui.mjs';
import { appUrl, repositoryUrl, route, type Locale } from '../lib/site';
import DocsLayout from '../layouts/DocsLayout.astro';
import GuideFigure from './GuideFigure.astro';
import Icon from './Icon.astro';
import { capturePair } from '../lib/captures.mjs';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = docsUI[locale];
const overview = t.landing;
const destinations: Record<string, string> = {
  painting: 'drawing/brush-tools', workspace: 'start/workspaces', input: 'input/pen',
  color: 'color/color-panel', photo: 'photo',
};
const topics = Object.entries(overview.sections).map(([id, copy]) => ({
  id, copy,
  href: id === 'native' ? repositoryUrl : destinations[id] ? route(locale, 'documentation', destinations[id]) : undefined,
}));
const startingPoints = 'links' in overview ? [
  { title: content[locale].nav.webDemo, href: appUrl },
  { title: content[locale].nav.download, href: route(locale, 'download') },
  { title: overview.links.quickstart, href: route(locale, 'documentation', 'quickstart') },
  { title: overview.links.illustration, href: route(locale, 'documentation', 'illustration') },
] : [];
---
<DocsLayout locale={locale}>
  <h1>{content[locale].documentation.title}</h1>
  <p class="docs-lead">{t.intro}</p>
  {'alt' in overview && <div class="docs-overview-image">
    <GuideFigure locale={locale} image={{ ...capturePair('guides/illustration', locale), alt: overview.alt }} />
  </div>}
  <div class:list={['docs-concepts', { 'docs-stories': 'sketch' in overview.sections }]}>
    {topics.map(({ id, copy, href }) => <section aria-labelledby={id}>
      {'image' in copy && <GuideFigure locale={locale} image={{ ...capturePair(copy.image.shot, locale), alt: copy.image.alt }} />}
      <h2 id={id}>{copy.title}</h2>
      {'links' in copy ? <div class="docs-story-text">
        {copy.text.split('\n\n').slice(0, -1).map((paragraph: string) => <p>{paragraph}</p>)}
        <div class="docs-story-summary">
          <blockquote><p>{copy.text.split('\n\n').at(-1).split(copy.title).map((part: string, index: number) => <>{index > 0 && <em>{copy.title}</em>}{part}</>)}</p></blockquote>
          <nav aria-label={`Learn more about ${copy.title}`}>
            <ul class="docs-story-links">
              {copy.links.map(({ title, slug }: { title: string; slug: string }) => <li><a href={route(locale, 'documentation', slug)}><span>{title}</span><Icon name="arrow" /></a></li>)}
            </ul>
          </nav>
        </div>
      </div> : <>
        <p>{copy.text}</p>
        {href && <a href={href}>{copy.link}<Icon name="arrow" /></a>}
      </>}
    </section>)}
  </div>
  {'start' in overview && <section class="docs-start" aria-labelledby="start">
    <h2 id="start">{t.startTitle}</h2>
    <p>{overview.start}</p>
    <ul class="docs-start-links">{startingPoints.map(({ title, href }) => <li>
      <a href={href}>{title}<Icon name="arrow" /></a>
    </li>)}</ul>
  </section>}
  {'tools' in overview && <section class="docs-features guide-prose" aria-labelledby="tools">
    <h2 id="tools">{overview.tools.title}</h2>
    <table>
      <thead><tr>{overview.tools.columns.map(column => <th scope="col">{column}</th>)}</tr></thead>
      <tbody>{overview.tools.rows.map(row => <tr>
        <td>{row.areas.map(({ title, slug }, index) => <>{index > 0 && ' and '}<a href={route(locale, 'documentation', slug)}>{title}</a></>)}</td>
        <td>{row.text}</td>
      </tr>)}</tbody>
    </table>
  </section>}
</DocsLayout>
