---
import { content } from '../data/content.mjs';
import { releasesUrl } from '../lib/releases.mjs';
import { releases } from '../lib/release-data';
import { betaPages, platforms, route, type Locale } from '../lib/site';
import { formatDate, formatSize } from '../lib/format';
import Icon from './Icon.astro';
import Phrase from './Phrase.astro';
import PwaInstructions from './PwaInstructions.astro';
import ReleaseNotes from './ReleaseNotes.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { lang } = content[locale];
const t = content[locale].download;
const [latest] = releases;
---
<main id="main" class="page">
  <h1>{t.title}</h1>
  {latest ? (
    <p class="lead"><Phrase text={t.released}><span slot="version">{latest.version}</span><time slot="date" datetime={latest.date}>{formatDate(lang, latest.date)}</time></Phrase></p>
  ) : <p class="lead">{t.intro}</p>}
  <ul class="platforms" aria-label={t.platformsLabel}>
    {platforms.map((platform, i) => {
      const file = platform === 'ipad' ? undefined : latest?.files[platform];
      const beta = betaPages[platform];
      return <li class="platform">
        <Icon name={platform} />
        <div class="platform-name"><h2 id={`platform-${platform}`}>{t.platforms[i]}</h2>{file && <p class="platform-detail">{formatSize(lang, file.size)}</p>}</div>
        {beta || file ? <div class="platform-links">
          {beta && <a class="button" href={route(locale, beta)} aria-describedby={`platform-${platform}`}>{t.joinBeta}</a>}
          {file && <a class="button" href={file.url} aria-describedby={`platform-${platform}`}><Icon name="download" />{t.get}</a>}
        </div> : <p>{t.status}</p>}
      </li>;
    })}
  </ul>
  {latest ? <>
    {latest.checksums && <p class="release-detail"><Phrase text={t.checksums}><a slot="file" href={latest.checksums.url}>{latest.checksums.name}</a></Phrase></p>}
    <p class="release-detail"><a href={route(locale, 'versions')}>{t.pastVersions}</a></p>
  </> : <p class="release-detail"><a href={releasesUrl}>{t.allReleases}<Icon name="external" /></a></p>}
  <PwaInstructions locale={locale} />
  {latest?.notes && <section class="whats-new" aria-labelledby="whats-new">
    <h2 id="whats-new"><Phrase text={t.notes}><span slot="version">{latest.version}</span></Phrase></h2>
    {locale !== 'en' && <p class="notes-language">{t.notesLanguage}</p>}
    <ReleaseNotes html={latest.notes} />
  </section>}
</main>

<style>
  .platform-name { min-width: 0; }
  .platform-name .platform-detail { margin: 0; font-size: 12px; color: var(--muted); }
  .platform-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; margin-left: auto; }
  .platform .button { padding-left: 16px; padding-right: 18px; white-space: nowrap; }
  .release-detail { max-width: 600px; margin: 16px 0 0; font-size: 13px; color: var(--muted); }
  .release-detail a { display: inline-flex; align-items: center; gap: 4px; color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .release-detail :global(svg) { width: 12px; height: 12px; }
  .whats-new { margin-top: 40px; max-width: 600px; }
  .whats-new h2 { font-size: 16px; font-weight: 650; margin-bottom: 8px; }
  .notes-language { font-size: 13px; color: var(--muted); }
</style>
