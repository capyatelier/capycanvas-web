---
import { docsUI } from '../data/docs-ui.mjs';
import type { Locale } from '../lib/site';
interface Props { locale: Locale; caption?: string; showHint?: boolean; image?: { light: string; dark: string; alt: string } }
const { locale, caption, image, showHint = true } = Astro.props;
---
<figure class="guide-figure">
  {image ? <a class="guide-image-link" href={image.light} data-light={image.light} data-dark={image.dark} aria-label={docsUI[locale].imageOpen}><picture>
    <source media="(prefers-color-scheme: dark)" srcset={image.dark} />
    <img src={image.light} alt={image.alt} width="1920" height="1080" loading="lazy" decoding="async" />
  </picture></a> : <div class="guide-image-slot">
    <svg aria-hidden="true" viewBox="0 0 48 36" fill="none"><path d="M5 29 17 15l9 10 7-7 10 11M30 9h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="30" cy="9" r="3" stroke="currentColor" stroke-width="2"/></svg>
    <span>{docsUI[locale].figureSoon}</span>
  </div>}
  {caption && <figcaption>{caption}</figcaption>}
  {image && showHint && <p class="guide-image-hint">{docsUI[locale].imageHint}</p>}
</figure>
<script>
  const appearance = matchMedia('(prefers-color-scheme: dark)');
  const update = () => document.querySelectorAll<HTMLAnchorElement>('.guide-image-link').forEach(link => {
    link.href = (appearance.matches ? link.dataset.dark : link.dataset.light)!;
  });
  update();
  appearance.addEventListener('change', update);
</script>
