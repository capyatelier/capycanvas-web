---
import { docsUI } from '../data/docs-ui.mjs';
import type { Locale } from '../lib/site';
import Icon from './Icon.astro';
import MenuField from './MenuField.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = docsUI[locale];
const systems = Object.keys(t.systems) as (keyof typeof t.systems)[];
---
<section class="platform-notes" aria-labelledby="device-notes">
  <h2 id="device-notes">{t.platformTitle}</h2>
  <p>{t.platformIntro}</p>
  <MenuField id="docs-platform" class="docs-platform" label={t.platform} value="all" hidden options={[
    { value: 'all', label: t.allPlatforms, icon: 'globe' },
    ...systems.map(system => ({ value: system, label: t.systems[system], icon: system })),
  ]} />
  <div class="platform-topics">{systems.map(system => <section data-doc-platform={system}>
    <h3><Icon name={system} />{t.systems[system]}</h3><p>{t.platformNotes[system]}</p>
  </section>)}</div>
</section>
<script>
  import { initPlatformNotes } from '../scripts/docs-platform';
  initPlatformNotes();
</script>
