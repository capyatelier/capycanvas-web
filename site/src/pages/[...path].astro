---
import { getEntry } from 'astro:content';
import Guide from '../components/Guide.astro';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { routes } from '../lib/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import Home from '../components/Home.astro';
import Download from '../components/Download.astro';
import Documentation from '../components/Documentation.astro';

export const getStaticPaths = (() => routes.map(({ locale, page, path, slug }) => ({
  params: { path: path.slice(1, -1) || undefined },
  props: { locale, page, slug },
}))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale, page, slug } = Astro.props;
const entry = slug ? await getEntry('guides', `${locale}/${slug}`) : undefined;
if (slug && !entry) throw new Error(`Missing guide ${locale}/${slug}`);
const PageContent = { home: Home, download: Download, documentation: Documentation }[page];
---
<SiteLayout locale={locale} page={page} slug={slug} title={entry?.data.title} description={entry?.data.description}>
  {entry ? <Guide locale={locale} slug={slug} entry={entry} /> : <PageContent locale={locale} />}
</SiteLayout>
