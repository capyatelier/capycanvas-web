---
import { getGuide } from '../lib/guides';
import Guide from '../components/Guide.astro';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { locales, route, routes } from '../lib/site';
import { docRedirects } from '../data/docs-nav.mjs';
import SiteLayout from '../layouts/SiteLayout.astro';
import Home from '../components/Home.astro';
import Download from '../components/Download.astro';
import Versions from '../components/Versions.astro';
import Beta from '../components/Beta.astro';
import Documentation from '../components/Documentation.astro';
import Privacy from '../components/Privacy.astro';
import DocumentationRedirect from '../components/DocumentationRedirect.astro';
import { content } from '../data/content.mjs';
import { releases } from '../lib/release-data';

export const getStaticPaths = (() => [
  ...routes.map(({ locale, page, path, slug }) => ({
    params: { path: path.slice(1, -1) || undefined },
    props: { locale, page, slug, redirect: false },
  })),
  ...routes.filter(({ page }) => page === 'documentation').map(({ locale, page, path, slug }) => ({
    params: { path: path.replace('/docs/', '/documentation/').slice(1, -1) },
    props: { locale, page, slug, redirect: true },
  })),
  ...locales.flatMap(locale => Object.entries(docRedirects).flatMap(([former, slug]) => ['docs', 'documentation'].map(segment => ({
    params: { path: route(locale, 'documentation', former).replace('/docs/', `/${segment}/`).slice(1, -1) },
    props: { locale, page: 'documentation' as const, slug, redirect: true },
  })))),
]) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale, page, slug, redirect } = Astro.props;
const entry = !redirect && slug ? await getGuide(locale, slug) : undefined;
if (!redirect && slug && !entry) throw new Error(`Missing guide ${locale}/${slug}`);
const PageContent = page === 'ipadBeta' || page === 'androidBeta' ? undefined : { home: Home, download: Download, versions: Versions, documentation: Documentation, privacy: Privacy }[page];
const released = page === 'download' && releases.length > 0;
const description = entry?.data.description ?? (released ? content[locale].download.metaReleased : undefined);
---
{redirect ? <DocumentationRedirect locale={locale} slug={slug} /> : <SiteLayout locale={locale} page={page} slug={slug} title={entry?.data.title} description={description}>
  {entry ? <Guide locale={locale} slug={slug} entry={entry} /> : page === 'ipadBeta' || page === 'androidBeta' ? <Beta locale={locale} page={page} /> : PageContent && <PageContent locale={locale} />}
</SiteLayout>}
