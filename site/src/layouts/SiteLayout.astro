---
import { content } from '../data/content.mjs';
import { origin, locales, route, type Locale, type SitePage } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguagePreference from '../components/LanguagePreference.astro';
import docsStyleUrl from '../styles/documentation.css?url';
interface Props { locale: Locale; page: SitePage; slug?: string; title?: string; description?: string }
const { locale, page, slug = '' } = Astro.props;
const t = content[locale];
const title = Astro.props.title ? `${Astro.props.title} — Capy Canvas` : page === 'home' ? t.home.title : page === '404' ? t.notFound.title : `${t[page].title} — Capy Canvas`;
const description = Astro.props.description ?? (page === '404' ? t.notFound.text : t[page].meta);
const canonical = origin + route(locale, page, slug);
const faviconVersion = import.meta.env.FAVICON_VERSION;
---
<!doctype html>
<html lang={t.lang} data-locale={locale} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="darkreader-lock" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {page === '404' ? <meta name="robots" content="noindex" /> : <>
      <link rel="canonical" href={canonical} />
      {locales.map(code => <link rel="alternate" hreflang={content[code].lang} href={origin + route(code, page, slug)} />)}
      <link rel="alternate" hreflang="x-default" href={origin + route('en', page, slug)} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Capy Canvas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${origin}/assets/workspace-light.webp`} />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="810" />
    <meta property="og:image:alt" content={t.home.screenshot} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ededed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#333333" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="32x32" href={`/assets/favicon.png?v=${faviconVersion}`} />
    <link rel="stylesheet" href="/assets/style.css" />
    {page === 'documentation' && <link rel="stylesheet" href={docsStyleUrl} />}
    <LanguagePreference locale={locale} page={page} slug={slug} />
  </head>
  <body class:list={{ 'has-footer': page !== 'home' }}>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <Header locale={locale} page={page} slug={slug} />
    <slot />
    {page !== 'home' && <Footer locale={locale} page={page} />}
  </body>
</html>
