{
  "name": "capycanvas-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "(MIT OR Apache-2.0)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "astro check --root site && astro build --root site",
    "dev": "cd site && astro dev",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:migration": "node tests/migration.mjs",
    "check": "npm run build && npm test && npm run test:browser",
    "serve": "node site/scripts/serve.mjs",
    "capture": "bash site/scripts/capture-headless.sh",
    "capture:prepare": "node site/scripts/prepare-capture.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "0.4.1",
    "@types/node": "24.13.4",
    "astro": "7.3.2",
    "pngjs": "7.0.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "satteri": "0.10.5",
    "typescript": "6.0.3",
    "unified": "11.0.5"
  }
}
